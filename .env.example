# =============================================================================
# Minimal Cashfree Payment Gateway
# Environment configuration
# =============================================================================
# Copy this file to .env and fill in your own values.
# NEVER commit real secrets to version control.

# Application
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Cashfree Payments (sandbox by default)
CASHFREE_APP_ID=your_sandbox_app_id
CASHFREE_SECRET_KEY=your_sandbox_secret_key
CASHFREE_API_VERSION=2025-08-01
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_WEBHOOK_SECRET=your_webhook_secret

# Payment amount limits (INR)
MIN_PAYMENT_AMOUNT=1
MAX_PAYMENT_AMOUNT=100000
