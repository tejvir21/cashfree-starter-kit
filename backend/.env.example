NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/cashfree-commerce
JWT_ACCESS_SECRET=change_this_access_secret_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_refresh_secret_to_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
DEFAULT_CURRENCY=INR
MIN_ORDER_AMOUNT_MINOR=100
MAX_ORDER_AMOUNT_MINOR=100000000
CASHFREE_APP_ID=your_sandbox_app_id
CASHFREE_SECRET_KEY=your_sandbox_secret_key
CASHFREE_API_VERSION=2025-08-01
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_WEBHOOK_URL=http://localhost:4000/api/v1/webhooks/cashfree
CASHFREE_WEBHOOK_SECRET=your_webhook_secret
MAX_FILE_SIZE_MB=5
ENABLE_GUEST_CHECKOUT=true
ENABLE_REFUNDS=true
