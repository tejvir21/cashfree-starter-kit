{
  "name": "cashfree-payment-gateway-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal Cashfree Payment Gateway Backend",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc --project tsconfig.build.json --noCheck",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.56.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
