{
  "extends": "./tsconfig.json",
  "compilerOptions": {"allowJs": true, "checkJs": false, "strict": false, "noEmitOnError": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests", "scripts"]
}



